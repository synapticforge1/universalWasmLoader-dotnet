// Create the GitHub Release for a tag and attach the packages, through GitHub's REST API with the
// job's GITHUB_TOKEN. Replaces `gh release create` (workspace letter H30, owner 2026-11-08: no `gh`,
// in CI too). Safe to re-run: an existing Release is kept and only the missing assets are uploaded,
// so a run that failed after the Release was made can finish (cf. workspace row C34 (1)).
//
//   dotnet10 tool run dotnet-script scripts/github-release.csx -- <tag> <dir> [--dry-run]
//   dotnet10 tool run dotnet-script scripts/github-release.csx -- selftest
//
// Environment: GITHUB_REPOSITORY (owner/name), GITHUB_TOKEN (not needed for --dry-run, which only
// reads the public API and prints what it would do), GITHUB_API_URL (default https://api.github.com).
// The assets are every *.nupkg and *.snupkg directly in <dir>. Only the .NET base library is used:
// no NuGet references, so the release job runs no package code besides dotnet-script itself.
// C# script run by dotnet-script, pinned in dotnet-tools.json (working-rules.md).

#nullable enable
using System.Net;
using System.Net.Http;
using System.Net.Http.Headers;
using System.Text;
using System.Text.Json;
using System.Text.RegularExpressions;

/// The tag must be a plain release tag: it goes into URLs and the Release title.
static bool ValidTag(string tag) => Regex.IsMatch(tag, @"^v[0-9]+\.[0-9]+\.[0-9]+$");

static bool ValidRepository(string repo) => Regex.IsMatch(repo, @"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$");

/// The files to attach, by name, sorted: every *.nupkg and *.snupkg directly in `dir`.
static List<string> AssetFiles(IEnumerable<string> fileNames) =>
    fileNames.Where(n => n.EndsWith(".nupkg", StringComparison.Ordinal) || n.EndsWith(".snupkg", StringComparison.Ordinal))
        .OrderBy(n => n, StringComparer.Ordinal).ToList();

/// The assets still to upload: the wanted names the Release does not already hold.
static List<string> Missing(IEnumerable<string> wanted, IEnumerable<string> present) =>
    wanted.Where(w => !present.Contains(w, StringComparer.Ordinal)).ToList();

/// The JSON body that creates the Release (GitHub writes the notes from the commits since the last tag).
static string CreateBody(string tag) =>
    JsonSerializer.Serialize(new Dictionary<string, object> { ["tag_name"] = tag, ["name"] = tag, ["generate_release_notes"] = true });

/// The upload URL for one asset, from the Release's `upload_url` template (`…/assets{?name,label}`).
static string UploadUrl(string template, string name) =>
    Regex.Replace(template, @"\{\?[^}]*\}$", "") + "?name=" + Uri.EscapeDataString(name);

static HttpClient Client(string? token)
{
    var http = new HttpClient { Timeout = TimeSpan.FromSeconds(60) };
    http.DefaultRequestHeaders.UserAgent.ParseAdd("universalWasmLoader-dotnet-release");
    http.DefaultRequestHeaders.Accept.ParseAdd("application/vnd.github+json");
    http.DefaultRequestHeaders.Add("X-GitHub-Api-Version", "2022-11-28");
    if (!string.IsNullOrEmpty(token)) http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
    return http;
}

static async Task<string> Must(HttpResponseMessage res, string what)
{
    var body = await res.Content.ReadAsStringAsync();
    if (!res.IsSuccessStatusCode) throw new Exception($"{what}: HTTP {(int)res.StatusCode}: {body[..Math.Min(300, body.Length)]}");
    return body;
}

static async Task<int> Release(string tag, string dir, bool dryRun)
{
    if (!ValidTag(tag)) throw new Exception($"not a release tag: '{tag}' (expected vX.Y.Z)");
    var repo = Environment.GetEnvironmentVariable("GITHUB_REPOSITORY") ?? "";
    if (!ValidRepository(repo)) throw new Exception($"GITHUB_REPOSITORY must be owner/name, got '{repo}'");
    var api = (Environment.GetEnvironmentVariable("GITHUB_API_URL") ?? "https://api.github.com").TrimEnd('/');
    var token = Environment.GetEnvironmentVariable("GITHUB_TOKEN");
    if (!dryRun && string.IsNullOrEmpty(token)) throw new Exception("GITHUB_TOKEN is not set");
    if (!Directory.Exists(dir)) throw new Exception($"no directory '{dir}'");
    var wanted = AssetFiles(Directory.GetFiles(dir).Select(Path.GetFileName).Select(n => n!));
    if (wanted.Count == 0) throw new Exception($"no .nupkg / .snupkg in '{dir}'");

    using var http = Client(dryRun ? null : token);
    var prefix = dryRun ? "[dry run] would " : "";

    // An existing Release for the tag is kept (a re-run); 404 means it is to be made.
    using var existing = await http.GetAsync($"{api}/repos/{repo}/releases/tags/{tag}");
    JsonElement release;
    if (existing.StatusCode == HttpStatusCode.NotFound)
    {
        Console.WriteLine($"{prefix}create the Release {tag} in {repo} (notes generated by GitHub)");
        if (dryRun)
        {
            foreach (var w in wanted) Console.WriteLine($"{prefix}upload {w}");
            return 0;
        }
        using var created = await http.PostAsync($"{api}/repos/{repo}/releases",
            new StringContent(CreateBody(tag), Encoding.UTF8, "application/json"));
        release = JsonDocument.Parse(await Must(created, "create the Release")).RootElement;
    }
    else
    {
        release = JsonDocument.Parse(await Must(existing, "read the Release")).RootElement;
        Console.WriteLine($"the Release {tag} already exists: {release.GetProperty("html_url").GetString()}");
    }

    var present = release.GetProperty("assets").EnumerateArray().Select(a => a.GetProperty("name").GetString()!).ToList();
    var missing = Missing(wanted, present);
    foreach (var name in wanted.Except(missing)) Console.WriteLine($"asset {name} already attached");
    foreach (var name in missing)
    {
        Console.WriteLine($"{prefix}upload {name}");
        if (dryRun) continue;
        var content = new ByteArrayContent(await File.ReadAllBytesAsync(Path.Combine(dir, name)));
        content.Headers.ContentType = new MediaTypeHeaderValue("application/octet-stream");
        using var up = await http.PostAsync(UploadUrl(release.GetProperty("upload_url").GetString()!, name), content);
        await Must(up, $"upload {name}");
    }
    Console.WriteLine($"{(dryRun ? "[dry run] " : "")}done: {release.GetProperty("html_url").GetString()}");
    return 0;
}

static int Selftest()
{
    int passed = 0, failed = 0;
    void Ok(string name, bool cond)
    {
        if (cond) passed++;
        else { failed++; Console.Error.WriteLine($"selftest FAILED: {name}"); }
    }
    Ok("tag: plain release tag", ValidTag("v0.2.0") && ValidTag("v10.11.12"));
    Ok("tag: refuses others", !ValidTag("0.2.0") && !ValidTag("v0.2") && !ValidTag("v0.2.0-rc.1") && !ValidTag("v0.2.0/../x") && !ValidTag("main"));
    Ok("repo: owner/name", ValidRepository("synapticforge1/universalWasmLoader-dotnet") && !ValidRepository("a/b/c") && !ValidRepository("a b/c"));
    Ok("assets: packages only, sorted",
        string.Join("|", AssetFiles(new[] { "x.snupkg", "README.md", "x.nupkg", "y.nupkg.tmp" })) == "x.nupkg|x.snupkg");
    Ok("missing: none when all present", Missing(new[] { "a", "b" }, new[] { "b", "a" }).Count == 0);
    Ok("missing: only the absent ones", string.Join("|", Missing(new[] { "a", "b", "c" }, new[] { "b" })) == "a|c");
    var body = JsonDocument.Parse(CreateBody("v1.2.3")).RootElement;
    Ok("body: tag, name, generated notes",
        body.GetProperty("tag_name").GetString() == "v1.2.3" && body.GetProperty("name").GetString() == "v1.2.3" && body.GetProperty("generate_release_notes").GetBoolean());
    Ok("upload url: template stripped, name escaped",
        UploadUrl("https://uploads.github.com/repos/o/r/releases/1/assets{?name,label}", "A b.nupkg") == "https://uploads.github.com/repos/o/r/releases/1/assets?name=A%20b.nupkg");
    Console.WriteLine($"selftest: {passed}/{passed + failed} passed");
    return failed == 0 ? 0 : 1;
}

try
{
    if (Args.Count == 1 && Args[0] == "selftest") Environment.Exit(Selftest());
    if (Args.Count is 2 or 3 && (Args.Count == 2 || Args[2] == "--dry-run"))
        Environment.Exit(await Release(Args[0], Args[1], Args.Count == 3));
    Console.Error.WriteLine("usage: github-release.csx <tag> <dir> [--dry-run] | selftest");
    Environment.Exit(2);
}
catch (Exception e)
{
    Console.Error.WriteLine($"github-release: {e.Message}");
    Environment.Exit(1);
}
