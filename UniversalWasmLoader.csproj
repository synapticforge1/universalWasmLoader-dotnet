<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PackageId>UniversalWasmLoader</PackageId>
    <Version>0.1.0</Version>
    <Authors>Jon Marcum</Authors>
    <Description>WIT-aware WebAssembly loader for .NET — the Go/JS/Rust sibling port. Loads a .wasm library, reads its companion .wit, and exposes each export as a type-safe .NET call with Canonical-ABI marshalling. Built on Wasmtime.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/synapticforge1/universalWasmLoader-dotnet</RepositoryUrl>
    <PackageTags>wasm;webassembly;wit;wasmtime;loader;canonical-abi</PackageTags>
  </PropertyGroup>

  <!-- The test project lives in tests/; keep its sources/content out of the library build. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**/*" />
    <None Remove="tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wasmtime" Version="44.0.0" />
  </ItemGroup>

  <!-- Compatibility gate Rule 1: the public API is declared in PublicAPI.Shipped.txt (as of the last
       release) + PublicAPI.Unshipped.txt (since), and a build fails when the code disagrees with
       them. Build-time only: PrivateAssets keeps it out of the package's dependencies. The package
       adds both files as AdditionalFiles itself; listing them again here duplicates them, and
       `dotnet format` then silently skips the fix that adds new symbols. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <!-- RS0016/RS0017: a public symbol added/removed without updating the files; RS0036/RS0037:
         nullable annotations missing from them. -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0036;RS0037</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
  </ItemGroup>

</Project>
